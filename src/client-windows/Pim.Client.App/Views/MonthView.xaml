<UserControl x:Class="Pim.Client.App.Views.MonthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Pim.Client.App.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Month Header with Navigation -->
        <Grid Grid.Row="0" Margin="24,16,24,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="‹" Style="{StaticResource SecondaryButton}"
                        Padding="12,6" FontSize="18"
                        Command="{Binding PreviousMonthCommand}"/>
                <TextBlock Text="{Binding MonthLabel}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="20,0"/>
                <Button Content="›" Style="{StaticResource SecondaryButton}"
                        Padding="12,6" FontSize="18"
                        Command="{Binding NextMonthCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Weekday Headers -->
        <UniformGrid Grid.Row="1" Columns="7" Margin="24,0,24,8">
            <TextBlock Text="日" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource DangerBrush}"/>
            <TextBlock Text="一" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBlock Text="二" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBlock Text="三" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBlock Text="四" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBlock Text="五" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBlock Text="六" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </UniformGrid>

        <!-- 7x6 Calendar Day Grid -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Days}" Margin="24,0,24,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:CalendarDay">
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0.5"
                            Padding="4" MinHeight="80" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick"
                                          Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}"/>
                        </Border.InputBindings>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <!-- Day Number Circle -->
                            <Border Width="26" Height="26" CornerRadius="13"
                                    HorizontalAlignment="Center" Margin="0,4,0,4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Day}" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontWeight="{Binding IsToday, Converter={StaticResource BoolToVisibility}}">
                                    <!-- Use DayColorHex for foreground -->
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"
                                                    Value="{Binding DayColorHex, Converter={StaticResource HexToBrush}}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <!-- Colored Dot Indicators (max 4) -->
                            <ItemsControl ItemsSource="{Binding Dots}" Margin="0,2,0,0"
                                          HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="5" Height="5" Margin="1,0" VerticalAlignment="Center"
                                                 Fill="{Binding Converter={StaticResource HexToBrush}}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Bottom Preview Panel -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="24,0,24,16">
            <StackPanel>
                <!-- Selected Date Label -->
                <TextBlock Text="{Binding SelectedDayLabel}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedDate}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedDate, Converter={StaticResource StringNotEmpty}}"
                                             Value="Visible">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Events Section -->
                <StackPanel Visibility="{Binding HasEvents, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="日程" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding SelectedEvents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:PreviewItem">
                                <Border Padding="10,8" Margin="0,0,0,4"
                                        Background="{StaticResource BgBrush}" CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="4" CornerRadius="2"
                                                Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                                Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Tasks Section -->
                <StackPanel Visibility="{Binding HasTasks, Converter={StaticResource BoolToVisibility}}"
                            Margin="0,8,0,0">
                    <TextBlock Text="任务" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding SelectedTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:PreviewItem">
                                <Border Padding="10,8" Margin="0,0,0,4"
                                        Background="{StaticResource BgBrush}" CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="4" CornerRadius="2"
                                                Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                                Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Empty State -->
                <TextBlock Text="选择一天查看日程和任务" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,12,0,4">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedDate}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasEvents}" Value="False"/>
                                        <Condition Binding="{Binding HasTasks}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasEvents}" Value="True"/>
                                        <Condition Binding="{Binding HasTasks}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasEvents}" Value="False"/>
                                        <Condition Binding="{Binding HasTasks}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
