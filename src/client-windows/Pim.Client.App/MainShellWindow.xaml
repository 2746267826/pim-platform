<Window x:Class="Pim.Client.App.MainShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PIM Companion Shell"
        Height="760"
        Width="1180"
        MinHeight="640"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PimMutedSurfaceBrush}"
        Loaded="OnLoaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource PimSurfaceBrush}"
                BorderBrush="{StaticResource PimBorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="16">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="PIM 伴随 Shell"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PimTextBrush}"/>
                    <TextBlock x:Name="AccountStateText"
                               Text="账户状态：检查中"
                               Margin="0,6,0,0"
                               FontSize="12"
                               Foreground="{StaticResource PimMutedTextBrush}"/>

                    <Border Margin="0,16,0,12"
                            Background="{StaticResource PimMutedSurfaceBrush}"
                            CornerRadius="10"
                            Padding="10">
                        <StackPanel>
                            <TextBlock Text="服务器"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PimMutedTextBrush}"/>
                            <TextBox x:Name="ServerUrlBox"
                                     Height="30"
                                     Margin="0,6,0,8"
                                     VerticalContentAlignment="Center"
                                     Padding="8,0"/>
                            <Button Content="保存服务器"
                                    Style="{StaticResource PimSecondaryButton}"
                                    Click="OnSaveServerUrl"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="工作台"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PimMutedTextBrush}"
                               Margin="0,4,0,8"/>

                    <Button Content="今日" Tag="/today" Click="OnNavigateRoute" Style="{StaticResource PimSecondaryButton}" Margin="0,0,0,6"/>
                    <Button Content="任务" Tag="/tasks" Click="OnNavigateRoute" Style="{StaticResource PimSecondaryButton}" Margin="0,0,0,6"/>
                    <Button Content="日历" Tag="/calendar" Click="OnNavigateRoute" Style="{StaticResource PimSecondaryButton}" Margin="0,0,0,6"/>
                    <Button Content="报告" Tag="/reports" Click="OnNavigateRoute" Style="{StaticResource PimSecondaryButton}" Margin="0,0,0,6"/>
                    <Button Content="Outlook Sync" Tag="/sync" Click="OnNavigateRoute" Style="{StaticResource PimSecondaryButton}" Margin="0,0,0,6"/>
                    <Button Content="Data Center" Tag="/data-center" Click="OnNavigateRoute" Style="{StaticResource PimSecondaryButton}" Margin="0,0,0,6"/>
                    <Button Content="确认详情" Tag="/confirmations" Click="OnNavigateRoute" Style="{StaticResource PimSecondaryButton}" Margin="0,0,0,6"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="{StaticResource PimMutedSurfaceBrush}"
                            CornerRadius="10"
                            Padding="10"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="通知中心"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PimTextBrush}"/>
                            <TextBlock x:Name="NotificationStateText"
                                       Text="低风险动作可直接执行，高风险动作打开 Web 审计详情。"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource PimMutedTextBrush}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="UploadStateText"
                               Text="采集上传状态：等待刷新"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{StaticResource PimMutedTextBrush}"
                               Margin="0,0,0,10"/>
                    <Button Content="状态 / 账户 / 服务器"
                            Style="{StaticResource PimPrimaryButton}"
                            Click="OnOpenStatusWindow"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Column="1"
                Margin="14"
                Background="{StaticResource PimSurfaceBrush}"
                BorderBrush="{StaticResource PimBorderBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="14,12,14,8">
                    <TextBlock x:Name="CurrentRouteText"
                               Text="/today"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PimMutedTextBrush}"
                               VerticalAlignment="Center"/>
                    <Button Content="刷新"
                            DockPanel.Dock="Right"
                            Style="{StaticResource PimSecondaryButton}"
                            Padding="12,5"
                            Click="OnRefresh"/>
                </DockPanel>
                <ContentControl x:Name="WebHostSlot"
                                Grid.Row="1"
                                Margin="14,0,14,14"/>
            </Grid>
        </Border>
    </Grid>
</Window>
