<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Disallow cloud backup for sensitive storage: allowBackup=false is primary,
             this file documents the exclusion intent and supports API 31+ tooling. -->
        <exclude domain="sharedpref" path="pim_auth.xml"/>
        <exclude domain="sharedpref" path="pim_auth"/>
        <exclude domain="database" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="pim_auth.xml"/>
        <exclude domain="sharedpref" path="pim_auth"/>
        <exclude domain="database" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
