<UserControl x:Class="Pim.Client.App.Views.TaskEditorDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="560" MaxHeight="700"
             Background="{StaticResource CardBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Dialog Title -->
        <TextBlock Grid.Row="0" Text="{Binding DialogTitle}" FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

        <!-- Scrollable Content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel>

                <!-- Title -->
                <TextBlock Text="标题" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontSize="16"
                         Style="{StaticResource ModernTextBox}" Margin="0,0,0,16" MaxLength="255"/>

                <!-- Task List Selector -->
                <TextBlock Text="任务列表" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <ListBox ItemsSource="{Binding TaskLists}"
                         SelectedItem="{Binding SelectedTaskList}"
                         SelectionMode="Single" Margin="0,0,0,16"
                         BorderThickness="0" Background="Transparent">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="16" Padding="12,8" Margin="0,0,8,4" Cursor="Hand"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Name}" FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- Description -->
                <TextBlock Text="描述" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBox}" AcceptsReturn="True"
                         Height="72" Margin="0,0,0,16"/>

                <!-- Location -->
                <TextBlock Text="地点" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

                <!-- Duration -->
                <TextBlock Text="预计时长" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding DurationOptions}" Margin="0,0,0,16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="16" Padding="12,6" Margin="0,0,8,4" Cursor="Hand"
                                    Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Button Content="{Binding Converter={StaticResource MinutesToDurationLabel}}"
                                        Command="{Binding DataContext.SelectDurationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Due Date -->
                <TextBlock Text="截止日期" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <DatePicker Grid.Column="0" SelectedDate="{Binding DueDate}"/>
                    <TextBox Grid.Column="1" Text="{Binding DueTime, UpdateSourceTrigger=LostFocus}"
                             Width="80" Margin="8,0,0,0"
                             Style="{StaticResource ModernTextBox}"
                             ToolTip="HH:mm"/>
                    <Button Grid.Column="2" Content="清除" Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButton}" Padding="12,6"
                            Command="{Binding ClearDueDateCommand}"/>
                </Grid>

                <!-- Priority -->
                <TextBlock Text="优先级" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <ListBox ItemsSource="{Binding PriorityOptions}"
                         SelectedItem="{Binding SelectedPriorityOption}"
                         SelectionMode="Single" Margin="0,0,0,16"
                         BorderThickness="0" Background="Transparent">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="16" Padding="12,6" Margin="0,0,8,4" Cursor="Hand"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10"
                                             Fill="{Binding Color, Converter={StaticResource HexToBrush}}"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Display}" FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="8,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- Repeat -->
                <TextBlock Text="重复" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <ListBox ItemsSource="{Binding RepeatOptions}"
                         SelectedItem="{Binding SelectedRepeatOption}"
                         SelectionMode="Single" Margin="0,0,0,16"
                         BorderThickness="0" Background="Transparent">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="16" Padding="12,6" Margin="0,0,8,4" Cursor="Hand"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Display}" FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- Reminder -->
                <TextBlock Text="提醒" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <ListBox ItemsSource="{Binding ReminderOptions}"
                         SelectedItem="{Binding SelectedReminderOption}"
                         SelectionMode="Single" Margin="0,0,0,16"
                         BorderThickness="0" Background="Transparent">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="16" Padding="12,6" Margin="0,0,8,4" Cursor="Hand"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Display}" FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- Toggle Switches -->
                <CheckBox Content="自动排程" IsChecked="{Binding IsAutoScheduled}" Margin="0,0,0,12"
                          Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                <CheckBox Content="允许拆分" IsChecked="{Binding IsSplittable}" Margin="0,0,0,12"
                          Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                <CheckBox Content="锁定排程" IsChecked="{Binding IsLocked}" Margin="0,0,0,12"
                          Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>

                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}" FontSize="12"
                           Foreground="#EF4444" Margin="0,0,0,8"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmpty}}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Save Button -->
        <Button Grid.Row="2" Content="保存" Style="{StaticResource PrimaryButton}"
                Command="{Binding SaveCommand}"
                HorizontalAlignment="Right" Margin="0,12,0,0"/>
    </Grid>
</UserControl>
