<UserControl x:Class="Pim.Client.App.Views.WeekView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ════════════════════════ Toolbar ════════════════════════ -->
        <Border Grid.Row="0" Padding="16,12"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="‹" Style="{StaticResource SecondaryButton}"
                        Padding="8,4" FontSize="14"
                        Command="{Binding PreviousWeekCommand}"/>
                <Button Content="今日" Style="{StaticResource SecondaryButton}"
                        Padding="8,4" FontSize="12" Margin="6,0"
                        Command="{Binding GoToTodayCommand}"/>
                <Button Content="›" Style="{StaticResource SecondaryButton}"
                        Padding="8,4" FontSize="14"
                        Command="{Binding NextWeekCommand}"/>
                <TextBlock Text="{Binding WeekLabel}" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="12,0"/>
            </StackPanel>
        </Border>

        <!-- ════════════════════════ Day Headers ════════════════════════ -->
        <Grid Grid.Row="1" Height="44" Margin="52,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding DayColumns[0].DayLabel}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding DayColumns[0].DateLabel}" FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DayColumns[0].IsToday}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding DayColumns[1].DayLabel}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding DayColumns[1].DateLabel}" FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DayColumns[1].IsToday}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding DayColumns[2].DayLabel}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding DayColumns[2].DateLabel}" FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DayColumns[2].IsToday}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding DayColumns[3].DayLabel}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding DayColumns[3].DateLabel}" FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DayColumns[3].IsToday}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding DayColumns[4].DayLabel}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding DayColumns[4].DateLabel}" FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DayColumns[4].IsToday}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding DayColumns[5].DayLabel}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding DayColumns[5].DateLabel}" FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DayColumns[5].IsToday}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding DayColumns[6].DayLabel}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding DayColumns[6].DateLabel}" FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DayColumns[6].IsToday}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Grid.ColumnSpan="8"/>

        <!-- ════════════════════════ Time Grid ════════════════════════ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" x:Name="TimeScroller">
            <Grid Height="1080">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Time Labels -->
                <ItemsControl Grid.Column="0" ItemsSource="{Binding HourEntries}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#888"
                                       Canvas.Top="{Binding Top}" Margin="4,-6,0,0"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0"/>

                <!-- Hour Grid Lines -->
                <ItemsControl Grid.Column="1" Grid.ColumnSpan="7" ItemsSource="{Binding HourEntries}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Line X1="0" X2="9999" Y1="0" Y2="0"
                                  Stroke="#F0F0F0" StrokeThickness="1"
                                  Canvas.Top="{Binding Top}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Vertical Column Separators -->
                <Line Grid.Column="1" X1="0" X2="0" Y1="0" Y2="9999"
                      Stroke="#E0E0E0" StrokeThickness="0.5" Stretch="Fill"/>
                <Line Grid.Column="2" X1="0" X2="0" Y1="0" Y2="9999"
                      Stroke="#E0E0E0" StrokeThickness="0.5" Stretch="Fill"/>
                <Line Grid.Column="3" X1="0" X2="0" Y1="0" Y2="9999"
                      Stroke="#E0E0E0" StrokeThickness="0.5" Stretch="Fill"/>
                <Line Grid.Column="4" X1="0" X2="0" Y1="0" Y2="9999"
                      Stroke="#E0E0E0" StrokeThickness="0.5" Stretch="Fill"/>
                <Line Grid.Column="5" X1="0" X2="0" Y1="0" Y2="9999"
                      Stroke="#E0E0E0" StrokeThickness="0.5" Stretch="Fill"/>
                <Line Grid.Column="6" X1="0" X2="0" Y1="0" Y2="9999"
                      Stroke="#E0E0E0" StrokeThickness="0.5" Stretch="Fill"/>
                <Line Grid.Column="7" X1="0" X2="0" Y1="0" Y2="9999"
                      Stroke="#E0E0E0" StrokeThickness="0.5" Stretch="Fill"/>

                <!-- Day 0 Items -->
                <ItemsControl Grid.Column="1" ItemsSource="{Binding DayColumns[0].Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="4,2"
                                    Canvas.Top="{Binding TopOffset}"
                                    Height="{Binding BlockHeight}"
                                    Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                    Opacity="0.85"
                                    Width="{Binding RelativeSource={RelativeSource AncestorType=Canvas}, Path=ActualWidth}">
                                <TextBlock Text="{Binding Title}" FontSize="11" Foreground="White"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Day 1 Items -->
                <ItemsControl Grid.Column="2" ItemsSource="{Binding DayColumns[1].Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="4,2"
                                    Canvas.Top="{Binding TopOffset}"
                                    Height="{Binding BlockHeight}"
                                    Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                    Opacity="0.85"
                                    Width="{Binding RelativeSource={RelativeSource AncestorType=Canvas}, Path=ActualWidth}">
                                <TextBlock Text="{Binding Title}" FontSize="11" Foreground="White"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Day 2 Items -->
                <ItemsControl Grid.Column="3" ItemsSource="{Binding DayColumns[2].Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="4,2"
                                    Canvas.Top="{Binding TopOffset}"
                                    Height="{Binding BlockHeight}"
                                    Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                    Opacity="0.85"
                                    Width="{Binding RelativeSource={RelativeSource AncestorType=Canvas}, Path=ActualWidth}">
                                <TextBlock Text="{Binding Title}" FontSize="11" Foreground="White"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Day 3 Items -->
                <ItemsControl Grid.Column="4" ItemsSource="{Binding DayColumns[3].Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="4,2"
                                    Canvas.Top="{Binding TopOffset}"
                                    Height="{Binding BlockHeight}"
                                    Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                    Opacity="0.85"
                                    Width="{Binding RelativeSource={RelativeSource AncestorType=Canvas}, Path=ActualWidth}">
                                <TextBlock Text="{Binding Title}" FontSize="11" Foreground="White"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Day 4 Items -->
                <ItemsControl Grid.Column="5" ItemsSource="{Binding DayColumns[4].Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="4,2"
                                    Canvas.Top="{Binding TopOffset}"
                                    Height="{Binding BlockHeight}"
                                    Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                    Opacity="0.85"
                                    Width="{Binding RelativeSource={RelativeSource AncestorType=Canvas}, Path=ActualWidth}">
                                <TextBlock Text="{Binding Title}" FontSize="11" Foreground="White"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Day 5 Items -->
                <ItemsControl Grid.Column="6" ItemsSource="{Binding DayColumns[5].Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="4,2"
                                    Canvas.Top="{Binding TopOffset}"
                                    Height="{Binding BlockHeight}"
                                    Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                    Opacity="0.85"
                                    Width="{Binding RelativeSource={RelativeSource AncestorType=Canvas}, Path=ActualWidth}">
                                <TextBlock Text="{Binding Title}" FontSize="11" Foreground="White"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Day 6 Items -->
                <ItemsControl Grid.Column="7" ItemsSource="{Binding DayColumns[6].Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="4,2"
                                    Canvas.Top="{Binding TopOffset}"
                                    Height="{Binding BlockHeight}"
                                    Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                    Opacity="0.85"
                                    Width="{Binding RelativeSource={RelativeSource AncestorType=Canvas}, Path=ActualWidth}">
                                <TextBlock Text="{Binding Title}" FontSize="11" Foreground="White"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
