<Window x:Class="Pim.Client.App.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PIM 守护程序状态" Height="520" Width="560"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource PimMutedSurfaceBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PimSurfaceBrush}"
                BorderBrush="{StaticResource PimBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16"
                Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="PIM 守护程序"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PimTextBrush}"/>
                        <TextBlock x:Name="AuthStatusText"
                                   Text="正在检查账户状态..."
                                   FontSize="12"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource PimMutedTextBrush}"/>
                    </StackPanel>
                    <Button x:Name="LoginButton"
                            Grid.Column="1"
                            Content="登录"
                            Style="{StaticResource PimPrimaryButton}"
                            Click="OnLogin"
                            VerticalAlignment="Top"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="服务器"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{StaticResource PimMutedTextBrush}"
                               Margin="0,0,8,0"/>
                    <TextBox x:Name="ServerUrlBox"
                             Grid.Column="1"
                             Height="30"
                             VerticalContentAlignment="Center"
                             Padding="8,0"/>
                    <Button Grid.Column="2"
                            Content="保存"
                            Style="{StaticResource PimSecondaryButton}"
                            Padding="12,5"
                            Margin="8,0,0,0"
                            Click="OnSaveServerUrl"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource PimSurfaceBrush}"
                BorderBrush="{StaticResource PimBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="StatusItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource PimBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="9"
                                                 Height="9"
                                                 Fill="{Binding ToneBrush}"
                                                 Margin="0,5,10,0"
                                                 VerticalAlignment="Top"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PimTextBrush}"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Summary}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource PimMutedTextBrush}"/>
                                    </Grid>
                                    <Expander Header="原始详情"
                                              Margin="19,8,0,0"
                                              Foreground="{StaticResource PimMutedTextBrush}">
                                        <TextBox Text="{Binding Detail}"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 BorderThickness="0"
                                                 Background="{StaticResource PimMutedSurfaceBrush}"
                                                 Foreground="{StaticResource PimTextBrush}"
                                                 FontFamily="Consolas"
                                                 FontSize="11"
                                                 Padding="8"
                                                 Margin="0,4,0,0"/>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="查看日志"
                    Style="{StaticResource PimSecondaryButton}"
                    Margin="0,0,8,0"
                    Click="OnViewLogs"/>
            <Button x:Name="ManualSyncButton"
                    Content="手动同步"
                    Style="{StaticResource PimPrimaryButton}"
                    Margin="0,0,8,0"
                    Click="OnManualSync"/>
            <Button Content="关闭"
                    Style="{StaticResource PimSecondaryButton}"
                    Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>
