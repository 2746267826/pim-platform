<UserControl x:Class="Pim.Client.App.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="全局搜索" FontSize="18" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

        <!-- Search Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Style="{StaticResource ModernTextBox}"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                     x:Name="SearchBox"
                     KeyDown="SearchBox_KeyDown"/>
            <Button Grid.Column="1" Content="搜索" Style="{StaticResource PrimaryButton}"
                    Margin="8,0,0,0" Command="{Binding SearchCommand}"/>
        </Grid>

        <!-- Filter Chips -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,50,0,12">
            <Button Content="全部" Style="{StaticResource SecondaryButton}"
                    Padding="8,4" FontSize="11" Margin="0,0,4,0"
                    Command="{Binding FilterByTypeCommand}" CommandParameter="{x:Null}"/>
            <Button Content="事件" Style="{StaticResource SecondaryButton}"
                    Padding="8,4" FontSize="11" Margin="0,0,4,0"
                    Command="{Binding FilterByTypeCommand}" CommandParameter="event"/>
            <Button Content="任务" Style="{StaticResource SecondaryButton}"
                    Padding="8,4" FontSize="11"
                    Command="{Binding FilterByTypeCommand}" CommandParameter="task"/>
        </StackPanel>

        <!-- Results -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Results}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10" Margin="0,0,0,4"
                                    Background="{StaticResource BgBrush}" CornerRadius="6">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border CornerRadius="3" Padding="4,2" Margin="0,0,8,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#DBEAFE"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="task">
                                                            <Setter Property="Background" Value="#FEF3C7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Type}" FontSize="10"/>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontSize="14"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Snippet}" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
