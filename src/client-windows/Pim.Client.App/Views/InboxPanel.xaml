<UserControl x:Class="Pim.Client.App.Views.InboxPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,16,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="12,0,12,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📥  收件箱 / 未排程" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="ⓘ" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           ToolTip="未排程的任务将显示在此处。您可以创建新任务，或使用一键重排快速分配时间。"/>
            </StackPanel>
        </StackPanel>

        <!-- Content Area -->
        <Grid Grid.Row="1" Margin="12,0,12,0">
            <!-- Empty State -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="✓" FontSize="32"
                           Foreground="{StaticResource SuccessBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding EmptyText}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
            </StackPanel>

            <!-- Task List -->
            <ScrollViewer Visibility="{Binding IsEmpty, Converter={StaticResource InverseBool}}"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" Margin="0,0,0,6"
                                    Background="{StaticResource CardBrush}"
                                    CornerRadius="8"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Priority Dot -->
                                    <Ellipse Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                                             Width="8" Height="8"
                                             Fill="{Binding Priority, Converter={StaticResource PriorityToBrush}}"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center"/>

                                    <!-- Title (max 2 lines) -->
                                    <TextBlock Grid.Column="1" Grid.Row="0"
                                               Text="{Binding Title}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="Wrap"
                                               MaxHeight="36"
                                               LineHeight="18"/>

                                    <!-- Metadata Tags Row -->
                                    <StackPanel Grid.Column="1" Grid.Row="1"
                                                Orientation="Horizontal"
                                                Margin="0,4,0,0">
                                        <!-- Duration Tag -->
                                        <Border CornerRadius="4" Padding="6,2"
                                                Background="{StaticResource BgBrush}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DurationMinutes}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="{Binding DurationMinutes, Converter={StaticResource MinutesToDurationLabel}}"/>
                                        </Border>

                                        <!-- Due Date Tag -->
                                        <Border CornerRadius="4" Padding="6,2"
                                                Background="{StaticResource BgBrush}"
                                                Margin="4,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Due}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="10">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Due, StringFormat='截止 {0:MM/dd}'}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>

                                    <!-- Drag Handle -->
                                    <TextBlock Grid.Column="2" Grid.Row="0" Grid.RowSpan="2"
                                               Text="⠿" FontSize="16"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Bottom Action Buttons -->
        <Border Grid.Row="2" Padding="12,12,12,16"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Background="{StaticResource BgBrush}">
            <StackPanel>
                <Button Content="+ 新建" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Stretch" Height="38" FontSize="13"/>
                <Button Content="⚡ 一键重排" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Stretch" Height="38" FontSize="12"
                        Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
