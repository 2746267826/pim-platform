<UserControl x:Class="Pim.Client.App.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Pim.Client.App.Converters">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:InverseBoolConverter x:Key="InverseBool"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="◀" Style="{StaticResource SecondaryButton}"
                        Padding="8,4" Command="{Binding PreviousMonthCommand}"/>
                <TextBlock Text="{Binding CurrentMonth, StringFormat='yyyy年MM月'}"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="12,0"/>
                <Button Content="▶" Style="{StaticResource SecondaryButton}"
                        Padding="8,4" Command="{Binding NextMonthCommand}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SyncOutlookButton" Content="同步 Outlook" Style="{StaticResource SecondaryButton}"
                        Padding="10,4" FontSize="12" Margin="0,0,8,0" Click="SyncOutlookButton_Click"/>
                <Button x:Name="ImportIcsButton" Content="导入 ICS" Style="{StaticResource SecondaryButton}"
                        Padding="10,4" FontSize="12" Margin="0,0,8,0" Click="ImportIcsButton_Click"/>
                <Button x:Name="ExportIcsButton" Content="导出 ICS" Style="{StaticResource SecondaryButton}"
                        Padding="10,4" FontSize="12" Margin="0,0,8,0" Click="ExportIcsButton_Click"/>
                <Button Content="+ 新建事件" Style="{StaticResource PrimaryButton}"
                        Command="{Binding OpenCreateEditorCommand}"
                        CommandParameter="{x:Null}"/>
            </StackPanel>
        </Grid>

        <!-- Calendar Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Month View -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Day Headers -->
                    <UniformGrid Grid.Row="0" Columns="7" Margin="0,0,0,8">
                        <TextBlock Text="一" HorizontalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="二" HorizontalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="三" HorizontalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="四" HorizontalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="五" HorizontalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="六" HorizontalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text="日" HorizontalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                    </UniformGrid>

                    <!-- Day Cells -->
                    <ItemsControl Grid.Row="1" x:Name="CalendarGrid">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Event List + Editor -->
            <Grid Grid.Column="1" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Event List -->
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="事件列表" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding Events}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,6" Margin="0,0,0,4"
                                                Background="{StaticResource BgBrush}" CornerRadius="4"
                                                Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick"
                                                              Command="{Binding DataContext.OpenEditEditorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="4" CornerRadius="2"
                                                        Background="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontSize="13"
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0:MM-dd HH:mm} - {1:HH:mm}">
                                                                <Binding Path="DtStart"/>
                                                                <Binding Path="DtEnd"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Event Editor Panel -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0"
                        Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="事件详情" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <TextBlock Text="标题" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,8"
                                 Text="{Binding EditorTitle, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="地点" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,8"
                                 Text="{Binding EditorLocation, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="描述" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,8"
                                 Text="{Binding EditorDescription, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" Height="60"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="开始" FontSize="12"/>
                                <TextBox Text="{Binding EditorStart, StringFormat='yyyy-MM-dd HH:mm'}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="结束" FontSize="12"/>
                                <TextBox Text="{Binding EditorEnd, StringFormat='yyyy-MM-dd HH:mm'}"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="取消" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding CloseEditorCommand}" Margin="0,0,8,0"/>
                            <Button Content="保存" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveEventCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
